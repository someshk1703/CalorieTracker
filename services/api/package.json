{
  "name": "@calorie-tracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "jest --config jest.config.ts",
    "test:contracts": "jest --config jest.config.ts --testMatch '**/tests/contract/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@calorie-tracker/shared": "*",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.3.3",
    "openai": "^5.1.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4"
  }
}